# Copy to .env. Used by `docker compose` and by `npm run dev` (server reads ../../.env).

# --- PostgreSQL (Docker Compose) -------------------------------------------
POSTGRES_USER=syncboard
POSTGRES_PASSWORD=syncboard
POSTGRES_DB=syncboard
POSTGRES_HOST_PORT=5434

# --- Server -----------------------------------------------------------------
# Local development (server on the host, Postgres in Docker):
DATABASE_URL=postgres://syncboard:syncboard@localhost:5434/syncboard
PORT=3001
# Browser origins allowed to call the API and open sockets (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Set to true when served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# One-click Alice/Bob/Charlie demo sign-in and the seeded demo board.
DEMO_MODE=true
# Restore the demo board every N minutes (0 = never). Useful for public demos.
DEMO_RESET_INTERVAL_MINUTES=0
LOG_LEVEL=info
LOG_PRETTY=true
